# ---------------------------------------------------------------------------
# EVORA GIFTING — Environment Variables
# Copy this file to `.env.local` (development) and fill in real values.
# NEVER commit `.env` or `.env.local` — they are already git-ignored.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ------------------------------------------
# Pooled connection string (used by the app at runtime, via PgBouncer/Supavisor)
DATABASE_URL="postgresql://postgres:password@localhost:5432/evora?schema=public&pgbouncer=true"
# Direct (non-pooled) connection string, used by `prisma migrate`
DIRECT_URL="postgresql://postgres:password@localhost:5432/evora?schema=public"

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only. Never expose to the browser / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- AI (provider-agnostic — see lib/ai) -------------------------------------
# Which provider implementation to use: "ollama" (default) | "none"
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
AI_MODEL="mistral:7b-instruct"

# --- WhatsApp Business Cloud API (Meta) --------------------------------------
# Leave blank in development — the abstraction falls back to `wa.me` deep
# links (no API credentials required) whenever these are unset.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN="evora-verify-token"
# Public number used to build wa.me links, in international format, no plus/spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER="911234567890"

# --- Email (provider-agnostic — see lib/email) -------------------------------
EMAIL_PROVIDER="none"
EMAIL_API_KEY=""
EMAIL_FROM="Evora Gifting <hello@evoragifting.com>"

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
