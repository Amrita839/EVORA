// EVORA GIFTING — Database Schema
// PostgreSQL via Supabase. Auth users live in Supabase's auth.users table;
// `Profile` extends that with app-specific fields (1:1 on the same UUID).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PREORDER
}

/// Controls how a product can be acquired — not every gift needs a hard
/// checkout; bulk/corporate/custom items are often enquiry-only.
enum PricingMode {
  BUYABLE
  ENQUIRY_ONLY
  BOTH
}

enum EnquiryType {
  GENERAL
  CORPORATE
  CUSTOM
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUOTED
  CONVERTED
  CLOSED
}

enum EnquirySource {
  WEBSITE
  WHATSAPP
  AI_ASSISTANT
  CORPORATE_FORM
  CUSTOM_FORM
  CONTACT_FORM
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum EventType {
  PAGE_VIEW
  PRODUCT_VIEW
  PRODUCT_CLICK
  SEARCH
  AI_MESSAGE
  ADD_TO_ENQUIRY
  WHATSAPP_CLICK
  ENQUIRY_SUBMITTED
  CORPORATE_QUOTE
  NEWSLETTER_SIGNUP
}

enum AiRole {
  USER
  ASSISTANT
  SYSTEM
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Extends Supabase auth.users (same id) with app-level profile data.
model Profile {
  id                String    @id @db.Uuid
  email             String    @unique
  fullName          String?
  phone             String?
  role              Role      @default(CUSTOMER)
  whatsappOptIn     Boolean   @default(false)
  whatsappOptInAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  enquiries         Enquiry[]
  productViews      ProductView[]
  aiConversations   AiConversation[]

  @@map("profiles")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  products    Product[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Occasion {
  id       String   @id @default(uuid()) @db.Uuid
  name     String
  slug     String   @unique
  products ProductOccasion[]

  @@map("occasions")
}

model Recipient {
  id       String   @id @default(uuid()) @db.Uuid
  name     String
  slug     String   @unique
  products ProductRecipient[]

  @@map("recipients")
}

model Product {
  id                     String      @id @default(uuid()) @db.Uuid
  name                   String
  slug                   String      @unique
  description            String
  shortDescription       String?
  price                  Decimal?    @db.Decimal(10, 2)
  compareAtPrice         Decimal?    @db.Decimal(10, 2)
  categoryId             String?     @db.Uuid
  sku                    String?     @unique
  stockStatus            StockStatus @default(IN_STOCK)
  pricingMode            PricingMode @default(BOTH)
  tags                   String[]    @default([])
  material               String?
  color                  String?
  isFeatured             Boolean     @default(false)
  isBestSeller           Boolean     @default(false)
  isNew                  Boolean     @default(false)
  isActive               Boolean     @default(true)
  isDemo                 Boolean     @default(false)
  customizationAvailable Boolean     @default(false)
  minimumOrderQuantity   Int         @default(1)
  corporateAvailable     Boolean     @default(false)
  metaTitle              String?
  metaDescription        String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  deletedAt              DateTime?

  category    Category?           @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  occasions   ProductOccasion[]
  recipients  ProductRecipient[]
  enquiryItems EnquiryItem[]
  views       ProductView[]

  @@index([isActive, isFeatured])
  @@index([isActive, isBestSeller])
  @@index([isActive, isNew])
  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String
  altText   String?
  sortOrder Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductOccasion {
  productId  String @db.Uuid
  occasionId String @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  occasion Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@id([productId, occasionId])
  @@map("product_occasions")
}

model ProductRecipient {
  productId   String @db.Uuid
  recipientId String @db.Uuid

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  recipient Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@id([productId, recipientId])
  @@map("product_recipients")
}

// ---------------------------------------------------------------------------
// Enquiries / Corporate & Custom Requests
// ---------------------------------------------------------------------------

model Enquiry {
  id                    String        @id @default(uuid()) @db.Uuid
  type                  EnquiryType   @default(GENERAL)
  status                EnquiryStatus @default(NEW)
  source                EnquirySource @default(WEBSITE)

  name                  String
  phone                 String
  email                 String?
  company               String?
  message               String?

  // Corporate / custom specific (nullable — only used by those flows)
  quantity              Int?
  budgetPerGift         Decimal?      @db.Decimal(10, 2)
  occasion              String?
  deliveryTimeline      String?
  customizationRequired Boolean?

  whatsappOptIn         Boolean       @default(false)

  userId                String?       @db.Uuid
  sessionId             String?

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user  Profile?      @relation(fields: [userId], references: [id])
  items EnquiryItem[]

  @@index([status, createdAt])
  @@index([type])
  @@map("enquiries")
}

model EnquiryItem {
  id        String  @id @default(uuid()) @db.Uuid
  enquiryId String  @db.Uuid
  productId String? @db.Uuid
  quantity  Int     @default(1)
  notes     String?

  enquiry Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@map("enquiry_items")
}

// ---------------------------------------------------------------------------
// Leads / CRM
// ---------------------------------------------------------------------------

model Lead {
  id               String     @id @default(uuid()) @db.Uuid
  name             String?
  phone            String     @unique
  email            String?
  company          String?
  source           String?
  status           LeadStatus @default(NEW)
  whatsappOptIn    Boolean    @default(false)
  whatsappOptInAt  DateTime?
  productsViewed   String[]   @default([])
  productsEnquired String[]   @default([])
  notes            String?
  lastActivityAt   DateTime   @default(now())
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([status])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Consent
// ---------------------------------------------------------------------------

model WhatsappConsent {
  id          String    @id @default(uuid()) @db.Uuid
  phoneNumber String
  whatsappOptIn Boolean @default(false)
  optInAt     DateTime?
  optOutAt    DateTime?
  source      String?
  sessionId   String?
  userId      String?   @db.Uuid
  createdAt   DateTime  @default(now())

  @@index([phoneNumber])
  @@map("whatsapp_consents")
}

model NewsletterSubscriber {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  whatsappOptIn Boolean  @default(false)
  phoneNumber   String?
  createdAt     DateTime @default(now())

  @@map("newsletter_subscribers")
}

// ---------------------------------------------------------------------------
// Analytics / Tracking
// ---------------------------------------------------------------------------

model ProductView {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  sessionId String?
  userId    String?  @db.Uuid
  createdAt DateTime @default(now())

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    Profile? @relation(fields: [userId], references: [id])

  @@index([productId, createdAt])
  @@index([sessionId])
  @@map("product_views")
}

model Event {
  id        String    @id @default(uuid()) @db.Uuid
  type      EventType
  sessionId String?
  userId    String?   @db.Uuid
  path      String?
  metadata  Json?
  createdAt DateTime  @default(now())

  @@index([type, createdAt])
  @@index([sessionId])
  @@map("events")
}

// ---------------------------------------------------------------------------
// AI Assistant
// ---------------------------------------------------------------------------

model AiConversation {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String?
  userId    String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     Profile?    @relation(fields: [userId], references: [id])
  messages AiMessage[]

  @@index([sessionId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  role           AiRole
  content        String
  productIds     String[] @default([])
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

model Testimonial {
  id          String   @id @default(uuid()) @db.Uuid
  authorName  String
  authorRole  String?
  company     String?
  content     String
  rating      Int      @default(5)
  imageUrl    String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("testimonials")
}

/// Singleton-style row (always id = "default") holding editable site config.
model SiteSettings {
  id                  String   @id @default("default")
  companyName         String   @default("Evora Gifting")
  tagline             String   @default("Every gift, intentional")
  phone               String?
  email               String?
  whatsappNumber      String?
  address             String?
  instagramUrl        String?
  linkedinUrl         String?
  facebookUrl         String?
  logoUrl             String?
  faviconUrl          String?
  footerText          String?
  businessHours       String?
  whatsappEnabled     Boolean  @default(false)
  corporateInfo       String?
  customGiftingInfo   String?
  updatedAt           DateTime @updatedAt

  @@map("site_settings")
}
